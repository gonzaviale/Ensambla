VITE_API_URL=/api
# ninguno: backend real | completo: todo simulado con MSW para tests/demos
# parcial: compatible con configuraciones anteriores; hoy todas las rutas usan el backend real
VITE_API_MOCKS=ninguno

# Cartografía interactiva de /ubicacion. Conservar atribución del proveedor configurado.
VITE_MAPA_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAPA_ATRIBUCION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
