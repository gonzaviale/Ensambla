# www redirige al dominio principal (necesita su propio registro DNS A).
www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}

{$DOMINIO} {
	encode zstd gzip

	# El backend atiende /api; el front lo llama en el mismo origen (VITE_API_URL=/api).
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Todo lo demás es el frontend (SPA): si el archivo no existe, devuelve index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Los assets con hash pueden cachearse un año.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
