{$DOMINIO} {
	encode zstd gzip

	# El backend atiende /api igual que el rewrite de Vercel.
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Todo lo demás es el frontend (SPA): si el archivo no existe, devuelve index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Los assets con hash pueden cachearse un año.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
