# Copiar como .env en el VPS (está en .gitignore) y completar. Nunca subir el .env.

# Dominio público (sin https://). Los registros DNS A tienen que apuntar a la IP del VPS.
# Para probar sin comprar dominio: 37-60-229-107.sslip.io
DOMINIO=

# Generar con: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=ensambla
POSTGRES_USER=ensambla_user

# Con 8 GB de RAM sobra; bajar si se agregan más servicios.
JAVA_OPTS=-XX:MaxRAMPercentage=50

# IA: simulado | anthropic | bedrock (ver backend/.../application-ensambla-secrets.properties.example)
ENSAMBLA_IA_PROVEEDOR=simulado
ENSAMBLA_IA_API_KEY=
# Quién puede usar la IA (lectura de cuadernos, Sami y taller). Con ENSAMBLA_IA_ACCESO_RESTRINGIDO=true sólo los
# dueños con email en la lista; el resto ve "La IA no está habilitada para tu cuenta". Para sumar a alguien: agregar
# el email a la lista y recrear el backend (docker compose up -d backend). Restringido con la lista vacía bloquea a todos.
ENSAMBLA_IA_ACCESO_RESTRINGIDO=false
# ENSAMBLA_IA_ACCESO_EMAILS=
# Opcionales (los valores de abajo son los defaults; descomentar para cambiarlos).
# Modelo de visión que pisa el del proveedor (vacío = el del proveedor).
# ENSAMBLA_IA_MODELO=
# ENSAMBLA_IA_TIMEOUT=60s
# Páginas/lecturas diarias de la cola de IA y apagado del worker (false en una instancia de evaluación).
# ENSAMBLA_IA_LIMITE_DIARIO=100
# ENSAMBLA_IA_WORKER=true
# ENSAMBLA_IA_ANTHROPIC_MODELO_RAPIDO=claude-haiku-4-5
# ENSAMBLA_IA_ANTHROPIC_MODELO_AVANZADO=claude-sonnet-4-6
# ENSAMBLA_IA_ANTHROPIC_MODELO_VISION=claude-haiku-4-5
# Sólo con ENSAMBLA_IA_PROVEEDOR=bedrock (en el VPS no hay perfil de ~/.aws: usar claves de un usuario IAM).
# ENSAMBLA_IA_BEDROCK_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Sami: vacío = usa el proveedor global de arriba; con valor, Sami usa ese.
# ENSAMBLA_SAMI_IA_PROVEEDOR=
# ENSAMBLA_SAMI_IA_REGION=
# ENSAMBLA_SAMI_IA_MODELO_RAPIDO=
# ENSAMBLA_SAMI_IA_MODELO_AVANZADO=
# Consultas diarias a la IA por negocio (chat y taller).
# ENSAMBLA_SAMI_LIMITE_DIARIO=20
# ENSAMBLA_SAMI_LIMITE_TALLER=60

# Motores programados y sesión (defaults).
# ENSAMBLA_AVISOS_MOTOR=true
# ENSAMBLA_AVISOS_PERIODO_DIAS=30
# ENSAMBLA_AVISOS_BAJA_ROTACION_FACTOR=0.5
# ENSAMBLA_AVISOS_IMPACTO=true
# ENSAMBLA_AVISOS_IMPACTO_VENTANA_DIAS=14
# ENSAMBLA_PRUEBAS_WORKER=true
# SESSION_TIMEOUT=2h

# Mercado Pago
ENSAMBLA_MP_HABILITADO=false
ENSAMBLA_MP_PRODUCCION=false
ENSAMBLA_MP_ACCESS_TOKEN=
ENSAMBLA_MP_COLLECTOR_ID=
ENSAMBLA_MP_APPLICATION_ID=
ENSAMBLA_MP_WEBHOOK_SECRET=
ENSAMBLA_MP_NOTIFICATION_URL=
ENSAMBLA_MP_RETURN_URL=

# WhatsApp con Evolution API. Para activarlo: COMPOSE_PROFILES=whatsapp, ENSAMBLA_WHATSAPP_PROVEEDOR=evolution y
# completar las claves (deploy.sh no cambia: docker compose lee COMPOSE_PROFILES de este archivo).
# Generar las claves con: openssl rand -hex 32
EVOLUTION_API_KEY=
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7
COMPOSE_PROFILES=
ENSAMBLA_WHATSAPP_PROVEEDOR=simulado
# Mismo valor en Evolution (viaja como ?token=) y en el backend. Generar con: openssl rand -hex 32
ENSAMBLA_WHATSAPP_WEBHOOK_SECRETO=
# Número de WhatsApp de Sami (el escaneado con el QR), sólo dígitos con código de país.
ENSAMBLA_WHATSAPP_NUMERO_BOT=
ENSAMBLA_WHATSAPP_EVOLUTION_INSTANCIA=ensambla
# Sami lee los mensajes recibidos y los pasa a filas a confirmar (false = sólo los guarda).
# ENSAMBLA_WHATSAPP_ATENCION_HABILITADA=true
