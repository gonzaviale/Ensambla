# Copiar como .env en el VPS (está en .gitignore) y completar. Nunca subir el .env.

# Dominio público (sin https://). Los registros DNS A tienen que apuntar a la IP del VPS.
# Para probar sin comprar dominio: 37-60-229-107.sslip.io
DOMINIO=

# Generar con: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=ensambla
POSTGRES_USER=ensambla_user

# Con 8 GB de RAM sobra; bajar si se agregan más servicios.
JAVA_OPTS=-XX:MaxRAMPercentage=50

# IA: simulado | anthropic | bedrock (ver backend/.../application-ensambla-secrets.properties.example)
ENSAMBLA_IA_PROVEEDOR=simulado
ENSAMBLA_IA_API_KEY=

# Mercado Pago
ENSAMBLA_MP_HABILITADO=false
ENSAMBLA_MP_PRODUCCION=false
ENSAMBLA_MP_ACCESS_TOKEN=
ENSAMBLA_MP_COLLECTOR_ID=
ENSAMBLA_MP_APPLICATION_ID=
ENSAMBLA_MP_WEBHOOK_SECRET=
ENSAMBLA_MP_NOTIFICATION_URL=
ENSAMBLA_MP_RETURN_URL=

# WhatsApp con Evolution API. Para activarlo: COMPOSE_PROFILES=whatsapp, ENSAMBLA_WHATSAPP_PROVEEDOR=evolution y
# completar las claves (deploy.sh no cambia: docker compose lee COMPOSE_PROFILES de este archivo).
# Generar las claves con: openssl rand -hex 32
EVOLUTION_API_KEY=
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7
COMPOSE_PROFILES=
ENSAMBLA_WHATSAPP_PROVEEDOR=simulado
# Mismo valor en Evolution (viaja como ?token=) y en el backend. Generar con: openssl rand -hex 32
ENSAMBLA_WHATSAPP_WEBHOOK_SECRETO=
# Número de WhatsApp de Sami (el escaneado con el QR), sólo dígitos con código de país.
ENSAMBLA_WHATSAPP_NUMERO_BOT=
ENSAMBLA_WHATSAPP_EVOLUTION_INSTANCIA=ensambla
