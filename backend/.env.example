# Variables de docker-compose.yml. Copiar como .env (está en .gitignore) sólo si hace falta cambiar los valores de
# desarrollo; si no existe, compose usa los valores por defecto. Si se cambian, actualizar también las variables
# SPRING_DATASOURCE_*.
ENSAMBLA_POSTGRES_DB=ensambla
ENSAMBLA_POSTGRES_USER=ensambla_user
ENSAMBLA_POSTGRES_PASSWORD=ensambla_pass
ENSAMBLA_POSTGRES_PORT=5435

# --- WhatsApp (Evolution API) ---
# Evolution se levanta junto con Postgres (docker compose up) y queda en http://localhost:${ENSAMBLA_EVOLUTION_PORT}.
# Para que el backend hable con él hay que arrancarlo con estas mismas variables (o en el archivo de secretos):
# ver docs/whatsapp-evolution.md.
ENSAMBLA_EVOLUTION_PORT=8081
# URL del webhook del backend vista desde el contenedor de Evolution (el backend corre en tu máquina).
ENSAMBLA_WEBHOOK_URL=http://host.docker.internal:8080/api/whatsapp/webhook
# Mismo valor en Evolution (viaja como ?token=) y en el backend (ENSAMBLA_WHATSAPP_WEBHOOK_SECRETO).
ENSAMBLA_WHATSAPP_WEBHOOK_SECRETO=cambiar-este-secreto
# Clave global de Evolution y la que usa el backend para hablarle: tienen que ser la misma.
ENSAMBLA_WHATSAPP_EVOLUTION_API_KEY=cambiar-esta-clave
# Backend: "simulado" (no envía nada) o "evolution".
ENSAMBLA_WHATSAPP_PROVEEDOR=simulado
ENSAMBLA_WHATSAPP_NUMERO_BOT=
ENSAMBLA_WHATSAPP_EVOLUTION_URL=http://localhost:8081
ENSAMBLA_WHATSAPP_EVOLUTION_INSTANCIA=ensambla
