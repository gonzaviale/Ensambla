# Copiar como application-ensambla-secrets.properties (está en .gitignore) y completar.
PORT=8080
FRONTEND_URL=http://localhost:5173
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5435/ensambla
SPRING_DATASOURCE_USERNAME=ensambla_user
SPRING_DATASOURCE_PASSWORD=ensambla_pass
# IA: "simulado" devuelve una lectura de ejemplo; para el proveedor real completar las tres variables.
ENSAMBLA_IA_PROVEEDOR=simulado
ENSAMBLA_IA_MODELO=
ENSAMBLA_IA_API_KEY=
# Almacenamiento S3 (MinIO en desarrollo): las credenciales son las de MinIO en el docker-compose.yml.
ENSAMBLA_ALMACENAMIENTO_ENDPOINT=http://localhost:9000
ENSAMBLA_ALMACENAMIENTO_ACCESS_KEY=ensambla_minio
ENSAMBLA_ALMACENAMIENTO_SECRET_KEY=ensambla_minio_pass
ENSAMBLA_ALMACENAMIENTO_BUCKET=ensambla-archivos
