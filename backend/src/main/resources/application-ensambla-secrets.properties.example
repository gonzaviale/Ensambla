# Copiar como application-ensambla-secrets.properties (está en .gitignore) y completar.
PORT=8080
FRONTEND_URL=http://localhost:5173
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5435/ensambla
SPRING_DATASOURCE_USERNAME=ensambla_user
SPRING_DATASOURCE_PASSWORD=ensambla_pass
# IA: "simulado" devuelve una lectura de ejemplo; para el proveedor real completar las tres variables.
ENSAMBLA_IA_PROVEEDOR=simulado
ENSAMBLA_IA_MODELO=
ENSAMBLA_IA_API_KEY=
# Proveedor real: ENSAMBLA_IA_PROVEEDOR=anthropic y ENSAMBLA_IA_MODELO=claude-haiku-5-5.
# Opcional, para estimar el costo (USD por millón de tokens, según la tarifa vigente del modelo):
# ENSAMBLA_IA_PROCESAMIENTO_PRECIO_ENTRADA_MILLON=
# ENSAMBLA_IA_PROCESAMIENTO_PRECIO_SALIDA_MILLON=
# WhatsApp: "simulado" no envía nada; con Evolution API (docs/whatsapp-evolution.md) completar todo.
ENSAMBLA_WHATSAPP_PROVEEDOR=simulado
ENSAMBLA_WHATSAPP_NUMERO_BOT=
ENSAMBLA_WHATSAPP_WEBHOOK_SECRETO=
ENSAMBLA_WHATSAPP_EVOLUTION_URL=http://localhost:8081
ENSAMBLA_WHATSAPP_EVOLUTION_API_KEY=
ENSAMBLA_WHATSAPP_EVOLUTION_INSTANCIA=ensambla
