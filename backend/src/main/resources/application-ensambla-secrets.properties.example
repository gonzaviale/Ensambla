# Copiar como application-ensambla-secrets.properties (está en .gitignore) y completar.
PORT=8080
FRONTEND_URL=http://localhost:5173
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5435/ensambla
SPRING_DATASOURCE_USERNAME=ensambla_user
SPRING_DATASOURCE_PASSWORD=ensambla_pass
# IA: "simulado" devuelve una lectura de ejemplo; para el proveedor real completar las tres variables.
ENSAMBLA_IA_PROVEEDOR=simulado
ENSAMBLA_IA_MODELO=
ENSAMBLA_IA_API_KEY=
# Proveedor real: ENSAMBLA_IA_PROVEEDOR=anthropic y ENSAMBLA_IA_MODELO=claude-haiku-5-5.
# Opcional, para estimar el costo (USD por millón de tokens, según la tarifa vigente del modelo):
# ENSAMBLA_IA_PROCESAMIENTO_PRECIO_ENTRADA_MILLON=
# ENSAMBLA_IA_PROCESAMIENTO_PRECIO_SALIDA_MILLON=

# Sami: "simulado" elige una plantilla sin costo; para Claude en Amazon Bedrock usar "bedrock" y las credenciales de AWS
# (un perfil de ~/.aws en ENSAMBLA_SAMI_IA_PERFIL_AWS, o las variables AWS_* / el rol de la instancia).
ENSAMBLA_SAMI_IA_PROVEEDOR=simulado
ENSAMBLA_SAMI_IA_REGION=us-east-1
ENSAMBLA_SAMI_IA_PERFIL_AWS=
# Modelos (perfiles de inferencia): el rapido atiende todo, el avanzado solo si el rapido no esta seguro.
# ENSAMBLA_SAMI_IA_MODELO_RAPIDO=us.anthropic.claude-haiku-4-5-20251001-v1:0
# ENSAMBLA_SAMI_IA_MODELO_AVANZADO=us.anthropic.claude-sonnet-4-6
# ENSAMBLA_SAMI_LIMITE_DIARIO=20
