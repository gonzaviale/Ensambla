# Copiar como application-ensambla-secrets.properties (está en .gitignore) y completar.
PORT=8080
FRONTEND_URL=http://localhost:5173
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5435/ensambla
SPRING_DATASOURCE_USERNAME=ensambla_user
SPRING_DATASOURCE_PASSWORD=ensambla_pass

# IA: un solo selector para la lectura de cuadernos y para Sami.
#   simulado  -> sin costo ni red: lectura de ejemplo, primera plantilla y taller que arma el kit del rubro.
#   anthropic -> API de Anthropic: completar ENSAMBLA_IA_API_KEY.
#   bedrock   -> Claude en Amazon Bedrock: región y credenciales de AWS (un perfil de ~/.aws en
#                ENSAMBLA_IA_BEDROCK_PERFIL_AWS, o las variables AWS_* / el rol de la instancia).
ENSAMBLA_IA_PROVEEDOR=simulado
# Modelo de visión que pisa el del proveedor (vacío = el del proveedor).
ENSAMBLA_IA_MODELO=

# Anthropic
ENSAMBLA_IA_API_KEY=
# ENSAMBLA_IA_ANTHROPIC_MODELO_RAPIDO=claude-haiku-4-5
# ENSAMBLA_IA_ANTHROPIC_MODELO_AVANZADO=claude-sonnet-4-6
# ENSAMBLA_IA_ANTHROPIC_MODELO_VISION=claude-haiku-4-5

# Amazon Bedrock (los modelos son perfiles de inferencia)
ENSAMBLA_IA_BEDROCK_REGION=us-east-1
ENSAMBLA_IA_BEDROCK_PERFIL_AWS=
# ENSAMBLA_IA_BEDROCK_MODELO_RAPIDO=us.anthropic.claude-haiku-4-5-20251001-v1:0
# ENSAMBLA_IA_BEDROCK_MODELO_AVANZADO=us.anthropic.claude-sonnet-4-6
# ENSAMBLA_IA_BEDROCK_MODELO_VISION=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Opcional, para estimar el costo de la lectura (USD por millón de tokens, según la tarifa vigente del modelo):
# ENSAMBLA_IA_PROCESAMIENTO_PRECIO_ENTRADA_MILLON=
# ENSAMBLA_IA_PROCESAMIENTO_PRECIO_SALIDA_MILLON=

# Sami: vacío usa lo de arriba; con valor, Sami usa eso (por ejemplo la lectura simulada y Sami con bedrock).
ENSAMBLA_SAMI_IA_PROVEEDOR=
# Pisan la región, el perfil y los modelos del proveedor sólo para Sami (vacío = los del proveedor).
ENSAMBLA_SAMI_IA_REGION=
ENSAMBLA_SAMI_IA_PERFIL_AWS=
# El rápido atiende todo; el avanzado sólo si el rápido no está seguro.
# ENSAMBLA_SAMI_IA_MODELO_RAPIDO=
# ENSAMBLA_SAMI_IA_MODELO_AVANZADO=
# ENSAMBLA_SAMI_LIMITE_DIARIO=20
# ENSAMBLA_SAMI_LIMITE_TALLER=60
