      "properties": {"layout": {"type": "string", "enum": ["mosaic", "single", "two", "three"]}}
    }
  },
  {
    "name": "ofrecer_opciones",
    "description": "Pregunta con botonera. Agrupá TODAS tus dudas del turno en UNA llamada con preguntas (hasta 3); con una sola alcanza pregunta y opciones. Se muestran de a una.",
