        "posicion": {"type": "integer"}
      },
      "required": ["pieza", "campo"]
    }
  },
  {
    "name": "cargar_registros",
    "description": "Suma registros reales (de una foto) a una pieza; hasta 30 filas.",
    "inputSchema": {
      "type": "object",
      "properties": {"pieza": {"type": "string"}, "filas": {"type": "array"}},
      "required": ["pieza", "filas"]
    }
  },
  {
    "name": "editar_registros",
    "description": "Corrige registros ya cargados de una pieza (los que figuran con su id en Sistema actual). Mandá sólo los datos que cambian. Para corregir, usá esta y no vuelvas a cargar la fila.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "pieza": {"type": "string"},
        "registros": {"type": "array", "description": "Lista de {id, datos: {Etiqueta: valor}}."}
      },
      "required": ["pieza", "registros"]
    }
  },
  {
    "name": "borrar_registros",
    "description": "Borra registros ya cargados de una pieza: por ids (los de Sistema actual) o los que coinciden con donde: {Etiqueta: valor} o una lista de esos (hasta 10). Para corregir un registro usá editar_registros, no borrar y cargar. Sin ids ni donde no borra nada.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "pieza": {"type": "string"},
        "ids": {"type": "array", "items": {"type": "string"}},
        "donde": {"type": "object", "description": "Datos que tienen que coincidir, por etiqueta; también acepta una lista de objetos."}
      },
      "required": ["pieza"]
    }
  },
  {
    "name": "conectar",
    "description": "Suma en desde un vínculo a hacia.",
